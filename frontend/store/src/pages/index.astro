---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import HeroMedia from '../components/HeroMedia.astro';
const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';
---
<BaseLayout title="Integra Sutec — Tecnología que impulsa tu día">
  <section class="hero" id="hero">
    <div class="hero-circuit" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1>Tecnología que<br/><span>impulsa tu día</span></h1>
      <HeroMedia />
    </div>
  </section>

  <section class="category-showcase" aria-label="Categorías">
    <div class="category-showcase-heading">
      <div><span>Explora por categoría</span><h2>Soluciones para cada momento</h2></div>
      <a href="/catalogo">Ver todos los productos <b>→</b></a>
    </div>
    <div class="category-grid" id="category-rail">
      <div class="category-loading">Cargando categorías…</div>
    </div>
  </section>

  <section class="featured-section">
    <div class="section-heading"><h2>Productos destacados</h2><a href="/catalogo">Ver todos →</a></div>
    <div id="featured-products" class="featured-grid" aria-live="polite">
      {Array.from({length:6}).map(() => <div class="product-card skeleton-card"><div></div><span></span><span></span><b></b></div>)}
    </div>
    <div id="home-error" class="home-error" hidden>No fue posible cargar el catálogo. <a href="/catalogo">Intentar desde productos</a>.</div>
  </section>

  <section class="benefit-bar" aria-label="Beneficios">
    <div><span>◆</span><p><strong>Compra segura</strong><small>Tus datos protegidos siempre</small></p></div>
    <div><span>▰</span><p><strong>Envío rápido</strong><small>A toda Guatemala</small></p></div>
    <div><span>♢</span><p><strong>Garantía local</strong><small>Respaldo y servicio en GT</small></p></div>
    <div><span>◉</span><p><strong>Soporte experto</strong><small>Te ayudamos a elegir</small></p></div>
  </section>

  <script define:vars={{ API }}>
    const categoryArt = {
      'Niños':{theme:'kids',icon:'<svg viewBox="0 0 64 64"><path d="M20 21c0-9 5-14 12-14s12 5 12 14v5c0 9-5 15-12 15s-12-6-12-15z"/><path d="M24 17c5 3 11 3 16 0M26 27h.1M38 27h.1M27 34c3 2 7 2 10 0M18 52c3-8 8-11 14-11s11 3 14 11"/><path d="M14 18c-4 2-5 8-2 12M50 18c4 2 5 8 2 12"/></svg>'},
      'Deportes':{theme:'sports',icon:'<svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="23"/><path d="m23 11 7 11-8 10-13-3M41 11l-7 11 8 10 13-3M22 53l8-11h4l8 11M22 32l8 10M42 32l-8 10"/></svg>'},
      'Familia':{theme:'family',icon:'<svg viewBox="0 0 64 64"><path d="M32 54S10 42 10 24c0-8 6-14 14-14 4 0 7 2 8 5 2-3 5-5 9-5 8 0 14 6 14 14 0 18-23 30-23 30z"/><path d="M22 29h20M32 19v20"/></svg>'},
      'Vehículos':{theme:'vehicles',icon:'<svg viewBox="0 0 64 64"><path d="m13 44-4-4V28l7-15h32l7 15v12l-4 4zM17 28h30M19 37h.1M45 37h.1M16 44v7M48 44v7"/><path d="M21 13h22"/></svg>'},
      'Empresas':{theme:'business',icon:'<svg viewBox="0 0 64 64"><path d="M10 54V12h29v42M39 25h15v29M20 22h9M20 32h9M20 42h9M45 34h4M45 43h4M6 54h52"/></svg>'},
      'Mascotas':{theme:'pets',icon:'<svg viewBox="0 0 64 64"><circle cx="19" cy="19" r="7"/><circle cx="45" cy="19" r="7"/><circle cx="13" cy="35" r="6"/><circle cx="51" cy="35" r="6"/><path d="M21 50c0-10 5-17 11-17s11 7 11 17c0 7-6 7-11 3-5 4-11 4-11-3z"/></svg>'},
      'Hogar':{theme:'home',icon:'<svg viewBox="0 0 64 64"><path d="m7 29 25-20 25 20M13 25v30h38V25M24 55V37h16v18"/><path d="M19 31h7M38 31h7"/></svg>'},
      'Seguridad':{theme:'security',icon:'<svg viewBox="0 0 64 64"><path d="M32 7 12 15v14c0 14 8 23 20 29 12-6 20-15 20-29V15z"/><path d="m22 31 7 7 14-17"/></svg>'},
    };
    const money = new Intl.NumberFormat('es-GT',{style:'currency',currency:'GTQ',minimumFractionDigits:2});
    const escapeHtml = (value='') => String(value).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
    const imageUrl = (path) => path ? (path.startsWith('http') ? path : API + path) : '';
    function renderCategories(items) {
      const rail = document.getElementById('category-rail'); if (!rail) return;
      rail.innerHTML = items.slice(0,8).map(cat => { const art=categoryArt[cat.name] || categoryArt.Empresas; return `<a class="category-card category-${art.theme}" href="/catalogo?category=${encodeURIComponent(cat._id)}"><span class="category-art">${art.icon}</span><span class="category-copy"><strong>${escapeHtml(cat.name)}</strong><small>${escapeHtml(cat.description || 'Soluciones para cada necesidad')}</small><em>Descubrir <b>→</b></em></span></a>`; }).join('');
      const footer = document.getElementById('footer-categories'); if (footer) footer.innerHTML = items.slice(0,8).map(cat => `<a href="/catalogo?category=${encodeURIComponent(cat._id)}">${escapeHtml(cat.name)}</a>`).join('');
    }
    function renderProducts(items) {
      const grid = document.getElementById('featured-products'); if (!grid) return;
      if (!items.length) { grid.innerHTML = '<p class="empty-products">No hay productos destacados disponibles.</p>'; return; }
      grid.innerHTML = items.slice(0,6).map((p,i) => { const img=imageUrl(p.images?.[0]); const desc=escapeHtml(p.description || p.category_id?.name || 'Producto tecnológico'); return `<article class="product-card"><button class="favorite-btn" data-favorite="${p._id}" aria-label="Agregar ${escapeHtml(p.name)} a favoritos">♡</button>${i<2?'<span class="new-badge">NUEVO</span>':''}<a class="product-image" href="/catalogo">${img?`<img src="${escapeHtml(img)}" alt="${escapeHtml(p.name)}" loading="lazy"/>`:'<span>IS</span>'}</a><h3>${escapeHtml(p.name)}</h3><p>${desc}</p><div class="product-bottom"><strong>${money.format(Number(p.unit_price || 0))}</strong><button class="quick-cart" data-product="${p._id}" aria-label="Ver producto en catálogo">🛒</button></div></article>`; }).join('');
      grid.querySelectorAll('[data-product]').forEach(btn => btn.addEventListener('click',()=>location.assign('/catalogo')));
      wireFavorites();
    }
    function renderHeroProducts(items) {
      const media = document.getElementById('hero-media');
      const images = items.map(item => ({ src:imageUrl(item.images?.[0]), name:item.name })).filter(item => item.src).slice(0,3);
      if (!media || !images.length) return;
      media.innerHTML = `<div class="hero-product-stage">${images.map((item,index) => `<img class="hero-product hero-product-${index+1}" src="${escapeHtml(item.src)}" alt="${escapeHtml(item.name)}"/>`).join('')}</div>`;
    }
    function wireFavorites() { const key='integrasutec:favorites:v1'; let saved=[]; try { saved=JSON.parse(localStorage.getItem(key)||'[]'); } catch {} document.querySelectorAll('[data-favorite]').forEach(btn=>{ const id=btn.dataset.favorite; const sync=()=>{btn.textContent=saved.includes(id)?'♥':'♡';btn.classList.toggle('active',saved.includes(id));}; sync(); btn.addEventListener('click',()=>{saved=saved.includes(id)?saved.filter(x=>x!==id):[...saved,id];try{localStorage.setItem(key,JSON.stringify(saved));}catch{}sync();}); }); }
    async function loadHome() { try { const [catsRes,productsRes] = await Promise.all([fetch(`${API}/api/categories`),fetch(`${API}/api/products?limit=6&status=active`)]); if(!catsRes.ok||!productsRes.ok) throw new Error(); const [cats,products]=await Promise.all([catsRes.json(),productsRes.json()]); renderCategories(cats.data||[]); renderProducts(products.data||[]); let bannerLoaded=false; try { const bannerRes=await fetch(`${API}/api/v1/public/banners`); if(bannerRes.ok){const data=await bannerRes.json();const banner=(data.items||data.data||[])[0];if(banner?.desktopImageUrl||banner?.desktopVideoUrl){window.__integraPendingHero=banner;if(window.renderIntegraHeroMedia)window.renderIntegraHeroMedia(banner);else window.dispatchEvent(new CustomEvent('integra:hero-media',{detail:banner}));bannerLoaded=true;}} } catch {} if(!bannerLoaded) renderHeroProducts(products.data||[]); } catch { document.getElementById('featured-products').innerHTML=''; document.getElementById('home-error').hidden=false; const rail=document.getElementById('category-rail'); rail.querySelector('.category-loading')?.remove(); } }
    loadHome();
  </script>
</BaseLayout>
