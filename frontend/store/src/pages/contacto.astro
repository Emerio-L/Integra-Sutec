---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';
---

<BaseLayout title="Contacto — Integra Sutec" description="Contacta a Integra Sutec para cotizaciones, soporte técnico o consultas sobre suministros tecnológicos.">
  <section class="bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-3 animate-slide-up">
        <span class="gradient-text">Contáctanos</span>
      </h1>
      <p class="text-dark-300 text-lg">Estamos aquí para ayudarte. Escríbenos y te responderemos a la brevedad.</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <!-- Contact Form -->
      <div class="lg:col-span-3">
        <div class="card p-8">
          <h2 class="font-display text-2xl font-bold text-dark-900 mb-6">Envíanos un mensaje</h2>
          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="contact-name" class="text-sm font-medium text-dark-700 block mb-1.5">Nombre completo</label>
                <input type="text" id="contact-name" name="name" required class="input-field" placeholder="Tu nombre" />
              </div>
              <div>
                <label for="contact-company" class="text-sm font-medium text-dark-700 block mb-1.5">Empresa</label>
                <input type="text" id="contact-company" name="company" class="input-field" placeholder="Nombre de tu empresa" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="contact-email" class="text-sm font-medium text-dark-700 block mb-1.5">Email</label>
                <input type="email" id="contact-email" name="email" required autocomplete="email" inputmode="email" class="input-field" placeholder="correo@empresa.com" />
              </div>
              <div>
                <label for="contact-phone" class="text-sm font-medium text-dark-700 block mb-1.5">Teléfono</label>
                <input type="tel" id="contact-phone" name="phone" class="input-field" placeholder="+502 0000-0000" />
              </div>
            </div>
            <div>
              <label for="contact-subject" class="text-sm font-medium text-dark-700 block mb-1.5">Asunto</label>
              <select id="contact-subject" name="subject" class="input-field">
                <option value="general">Consulta general</option>
                <option value="cotizacion">Solicitar cotización</option>
                <option value="soporte">Soporte técnico</option>
                <option value="partnership">Alianzas comerciales</option>
              </select>
            </div>
            <div>
              <label for="contact-message" class="text-sm font-medium text-dark-700 block mb-1.5">Mensaje</label>
              <textarea id="contact-message" name="message" rows="5" required class="input-field resize-none" placeholder="¿En qué podemos ayudarte?"></textarea>
            </div>
            <button type="submit" class="btn-primary w-full sm:w-auto">
              Enviar Mensaje
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            </button>
            <div id="contact-success" class="contact-feedback contact-feedback-success" role="status" aria-live="polite" hidden>
              <span class="contact-feedback-icon">✓</span>
              <div><strong>Mensaje enviado correctamente</strong><p>Gracias por contactarnos. Nuestro equipo revisará tu mensaje y te responderá a la brevedad.</p></div>
            </div>
            <div id="contact-error" class="contact-feedback contact-feedback-error" role="alert" aria-live="assertive" hidden>
              <span class="contact-feedback-icon">!</span>
              <div><strong>No fue posible enviar el mensaje</strong><p id="contact-error-text">Revisa tus datos e inténtalo nuevamente.</p></div>
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="lg:col-span-2 space-y-6">
        <div class="card p-6 hover:-translate-y-1">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-dark-900 mb-1">Dirección</h3>
              <p class="text-sm text-dark-500">Condominio Villa Real, km 18.5 Carretera a San José Pinula, #139, zona 7, Santa Catarina Pinula</p>
            </div>
          </div>
        </div>

        <div class="card p-6 hover:-translate-y-1">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-accent-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-dark-900 mb-1">Teléfonos</h3>
              <p class="text-sm text-dark-500"><a href="tel:+50235387468" class="hover:text-primary-600 transition-colors">+502 3538-7468</a></p>
              <p class="text-sm text-dark-500"><a href="tel:+50251446336" class="hover:text-primary-600 transition-colors">+502 5144-6336</a></p>
              <p class="text-xs text-dark-400 mt-1">Lun - Vie: 8:00 AM - 5:30 PM</p>
            </div>
          </div>
        </div>

        <div class="card p-6 hover:-translate-y-1">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-dark-900 mb-1">Email</h3>
              <p class="text-sm text-dark-500">ventas@integrasutec.com</p>
              <p class="text-sm text-dark-500">soporte@integrasutec.com</p>
            </div>
          </div>
        </div>

        <div class="card p-6 hover:-translate-y-1">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-accent-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-dark-900 mb-1">Horario</h3>
              <p class="text-sm text-dark-500">Lunes a Viernes</p>
              <p class="text-sm text-dark-500">8:00 AM - 5:30 PM</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ API }}>
    const form = document.getElementById('contact-form');
    const btn  = form?.querySelector('button[type="submit"]');
    const successPanel = document.getElementById('contact-success');
    const errorPanel = document.getElementById('contact-error');
    const errorText = document.getElementById('contact-error-text');
    const emailField = document.getElementById('contact-email');

    // Algunos teclados en español generan @ mediante AltGr (Ctrl+Alt).
    // Normalizamos esas combinaciones para evitar que el navegador las trate
    // como un atajo de navegación y conservamos el foco/cursor en el campo.
    emailField?.addEventListener('keydown', (e) => {
      const altGraph = e.getModifierState?.('AltGraph') || (e.ctrlKey && e.altKey);
      const atCombination = altGraph && (e.key === '@' || e.code === 'KeyQ' || e.code === 'Digit2');
      if (!atCombination) {
        if (e.key === '@') e.stopPropagation();
        return;
      }

      e.preventDefault();
      e.stopPropagation();
      const start = emailField.selectionStart ?? emailField.value.length;
      const end = emailField.selectionEnd ?? start;
      emailField.setRangeText('@', start, end, 'end');
      emailField.dispatchEvent(new Event('input', { bubbles: true }));
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const original = btn.innerHTML;
      successPanel.hidden = true;
      errorPanel.hidden = true;
      btn.disabled = true;
      btn.textContent = 'Enviando...';

      const payload = {
        name:    document.getElementById('contact-name').value,
        email:   document.getElementById('contact-email').value,
        phone:   document.getElementById('contact-phone').value,
        company: document.getElementById('contact-company').value,
        subject: document.getElementById('contact-subject').value,
        message: document.getElementById('contact-message').value,
      };

      try {
        const res  = await fetch(`${API}/api/contacts/public`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok) {
          form.reset();
          successPanel.hidden = false;
          successPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          errorText.textContent = json.error || 'Revisa tus datos e inténtalo nuevamente.';
          errorPanel.hidden = false;
          errorPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } catch {
        errorText.textContent = 'No pudimos conectar con el servicio. Verifica tu conexión e inténtalo nuevamente.';
        errorPanel.hidden = false;
        errorPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  </script>
</BaseLayout>

<style>
  .contact-feedback{margin-top:18px;padding:17px 18px;border-radius:14px;display:flex;align-items:flex-start;gap:13px;box-shadow:0 12px 30px rgba(15,23,42,.08)}
  .contact-feedback[hidden]{display:none!important}.contact-feedback-icon{width:30px;height:30px;display:grid;place-items:center;flex:0 0 auto;border-radius:50%;font-weight:900}.contact-feedback strong{display:block;margin-bottom:3px;font:700 15px Outfit}.contact-feedback p{margin:0;font-size:13px;line-height:1.55}
  .contact-feedback-success{border:1px solid #a7e4d2;background:linear-gradient(135deg,#effcf7,#e5f8f4);color:#116149}.contact-feedback-success .contact-feedback-icon{background:#c8f0e3;color:#087b5e}
  .contact-feedback-error{border:1px solid #fecaca;background:linear-gradient(135deg,#fff7f7,#fff0f0);color:#9f2424}.contact-feedback-error .contact-feedback-icon{background:#fee2e2;color:#c62828}
</style>
