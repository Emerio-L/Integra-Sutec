---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const values = [
  { icon: '🎯', title: 'Misión', text: 'Proveer soluciones tecnológicas integrales de alta calidad que potencien la productividad y competitividad de las empresas guatemaltecas.' },
  { icon: '🌟', title: 'Visión', text: 'Ser el socio tecnológico de referencia en Guatemala, reconocido por la excelencia en servicio, variedad de productos y compromiso con el cliente.' },
  { icon: '💎', title: 'Valores', text: 'Integridad, compromiso, innovación, servicio al cliente y trabajo en equipo son los pilares que guían nuestras operaciones.' },
];

---

<BaseLayout title="Nosotros — Integra Sutec" description="Conoce a Integra en Suministros y Tecnología, S.A. Tu socio estratégico en tecnología en Guatemala.">
  <!-- Header -->
  <section class="bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-3xl md:text-5xl font-bold text-white mb-4 animate-slide-up">
        Sobre <span class="gradient-text">Integra Sutec</span>
      </h1>
    </div>
  </section>

  <!-- Mission, Vision, Values -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {values.map((v) => (
        <div class="card p-8 text-center hover:-translate-y-1">
          <div class="text-4xl mb-4">{v.icon}</div>
          <h3 class="font-display text-xl font-bold text-dark-900 mb-3">{v.title}</h3>
          <p class="text-dark-500 text-sm leading-relaxed">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Purpose -->
  <section class="about-purpose py-20">
    <div class="about-glow about-glow-one"></div><div class="about-glow about-glow-two"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(360px,0.85fr)] gap-10 lg:gap-14 items-start">
        <div class="about-story">
          <span class="about-eyebrow">Quiénes somos</span>
          <h2 class="section-title mb-4 text-white">Tecnología con <span class="gradient-text">propósito</span></h2>
          <p class="about-intro">Soluciones pensadas desde la necesidad real, no solamente desde la tecnología.</p>
          <div class="about-narrative">
            <p class="about-lead">
              <strong>Integra en Suministros y Tecnología, S.A.</strong> nace con el propósito de acercar al mercado guatemalteco soluciones tecnológicas útiles, confiables y adaptadas a necesidades reales.
            </p>
            <div class="about-copy">
              <p>Detrás de Integra Sutec hay conocimientos en tecnología, soporte técnico y soluciones digitales, junto con una comprensión de lo que las personas y las empresas buscan al elegir un producto tecnológico.</p>
              <p>Nuestro enfoque no consiste únicamente en incorporar dispositivos a un catálogo. Buscamos comprender para qué sirven, qué necesidad resuelven y qué valor pueden aportar a la vida diaria de nuestros clientes.</p>
              <p>Comenzamos con productos de tecnología inteligente y continuaremos ampliando nuestro catálogo hacia soluciones para niños, deporte, familia, transporte, empresas, mascotas, hogar y seguridad.</p>
            </div>
            <p class="about-closing">Estamos construyendo nuestra trayectoria con transparencia, atención cercana y mejora continua. Queremos que la confianza en Integra Sutec se forme a partir de lo que realmente ofrecemos y de la experiencia que brindamos antes, durante y después de cada compra.</p>
          </div>
        </div>

        <aside class="about-focus-card p-7 md:p-8 lg:sticky lg:top-28">
          <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-primary-100 text-primary-700 mb-5">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3 4 7v5c0 4.5 3 7.5 8 9 5-1.5 8-4.5 8-9V7z"/><path d="m9 12 2 2 4-5"/>
            </svg>
          </div>
          <h3 class="font-display text-2xl font-bold text-dark-900 mb-6">Nuestro enfoque</h3>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-50 text-primary-600 grid place-items-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 22h4M8.5 14.5A7 7 0 1 1 15.5 14.5C14.6 15.2 14 16.1 14 17h-4c0-.9-.6-1.8-1.5-2.5z"/></svg>
              </div>
              <div><h4 class="font-semibold text-dark-900 mb-1">Utilidad real</h4><p class="text-sm leading-relaxed text-dark-500">Seleccionamos productos que respondan a necesidades concretas y aporten beneficios prácticos.</p></div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-50 text-primary-600 grid place-items-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12 5 5L20 6"/><path d="M20 12a8 8 0 1 1-4-7"/></svg>
              </div>
              <div><h4 class="font-semibold text-dark-900 mb-1">Selección responsable</h4><p class="text-sm leading-relaxed text-dark-500">Evaluamos la funcionalidad, calidad y relación de valor antes de incorporar un producto.</p></div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-50 text-primary-600 grid place-items-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 15a4 4 0 0 1-4 4H8l-4 3v-7a4 4 0 0 1-2-3.5v-3A4.5 4.5 0 0 1 6.5 4h9A4.5 4.5 0 0 1 20 8.5z"/><path d="M7 10h.01M11 10h.01M15 10h.01"/></svg>
              </div>
              <div><h4 class="font-semibold text-dark-900 mb-1">Atención cercana</h4><p class="text-sm leading-relaxed text-dark-500">Orientamos a nuestros clientes para que puedan elegir y aprovechar mejor cada solución.</p></div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-primary-50 text-primary-600 grid place-items-center">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0 1 13.6-5.7L20 9M20 4v5h-5M20 12a8 8 0 0 1-13.6 5.7L4 15M4 20v-5h5"/></svg>
              </div>
              <div><h4 class="font-semibold text-dark-900 mb-1">Evolución constante</h4><p class="text-sm leading-relaxed text-dark-500">Incorporamos nuevas categorías de acuerdo con las necesidades reales del mercado.</p></div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-primary-600 to-primary-800 py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-white mb-4">¿Buscas una solución tecnológica?</h2>
      <p class="text-primary-100 mb-8">Explora nuestros productos o contáctanos para encontrar una opción adecuada para ti, tu familia o tu empresa.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/catalogo" class="btn-accent px-8 py-4">Ver productos</a>
        <a href="/contacto" class="inline-flex items-center justify-center px-8 py-4 rounded-xl border border-white/40 text-white font-semibold hover:bg-white/10 transition-colors">Contáctanos</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-purpose{position:relative;overflow:hidden;background:linear-gradient(145deg,#03132f 0%,#06265a 54%,#073d78 100%)}
  .about-purpose:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(71,151,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(71,151,255,.055) 1px,transparent 1px);background-size:58px 58px;mask-image:linear-gradient(90deg,#000,transparent 78%)}
  .about-glow{position:absolute;border-radius:50%;filter:blur(4px);pointer-events:none}.about-glow-one{width:420px;height:420px;right:-140px;top:-170px;background:radial-gradient(circle,rgba(12,191,226,.25),transparent 68%)}.about-glow-two{width:360px;height:360px;left:-180px;bottom:-150px;background:radial-gradient(circle,rgba(20,105,255,.28),transparent 70%)}
  .about-eyebrow{display:inline-flex;padding:7px 12px;margin-bottom:14px;border:1px solid rgba(74,205,235,.34);border-radius:999px;background:rgba(6,196,202,.08);color:#64e6dc;font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  .about-intro{max-width:620px;margin:0 0 30px;color:#b7c9e6;font-size:17px;line-height:1.65}
  .about-narrative{position:relative;overflow:hidden;padding:30px 32px;border:1px solid rgba(255,255,255,.7);border-radius:24px;background:linear-gradient(145deg,rgba(238,248,255,.98) 0%,rgba(255,255,255,.96) 48%,rgba(225,244,249,.96) 100%);box-shadow:0 28px 70px rgba(0,8,30,.26),inset 0 1px #fff}.about-narrative:before{content:"";position:absolute;width:240px;height:240px;right:-120px;top:-130px;border-radius:50%;background:radial-gradient(circle,rgba(15,184,207,.18),transparent 70%);pointer-events:none}
  .about-lead{position:relative;margin:0 0 24px;padding:0 0 24px 20px;border-left:3px solid transparent;border-bottom:1px solid #dbe8f4;border-image:linear-gradient(180deg,#08becd,#176cff) 1;color:#27415f;font-size:17px;line-height:1.75}.about-lead strong{color:#071a3d;font-weight:800}.about-copy{display:grid;gap:18px}.about-copy p{margin:0;color:#465e79;font-size:15px;line-height:1.78}.about-copy p+p{padding-top:18px;border-top:1px solid rgba(175,197,220,.52)}.about-closing{position:relative;margin:24px 0 0;padding:22px 0 0;border-top:1px solid #cfdeec;color:#173b67;font-size:15px;font-weight:600;line-height:1.78}
  .about-focus-card{border:1px solid rgba(255,255,255,.8);border-radius:24px;background:linear-gradient(155deg,#fff 0%,#eef6ff 100%);box-shadow:0 28px 70px rgba(0,8,30,.3),inset 0 1px #fff}
  @media(max-width:640px){.about-purpose{padding-top:58px;padding-bottom:58px}.about-narrative{padding:24px 21px}.about-lead{padding:0 0 21px 15px;font-size:16px}.about-closing{padding-top:20px}.about-intro{font-size:15px}}
</style>
